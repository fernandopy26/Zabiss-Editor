{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zabiss Editor",
  "version": "1.0.0",
  "identifier": "studio.neko.zabiss-editor",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "cp index.html style.css app.js coi-serviceworker.js favicon.svg dist/"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zabiss Editor",
        "width": 1200,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data: blob: asset: http://asset.localhost; media-src * blob: data: asset: http://asset.localhost; img-src * data: blob: asset: http://asset.localhost; connect-src *; font-src * data:"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdEMzJCNTg1QzY2OTEzREEKUldUYUUybkdoYlV5Zlh0NXVSVDVXcXFUN3BSS3BwbDFDQ2Rjd2FCSTlidlViZkpiVi82LytCT3IK",
      "endpoints": [
        "https://github.com/fernandopy26/Zabiss-Editor/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}
